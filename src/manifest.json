{
  "manifest_version": 3,
  "name": "Firnkey",
  "short_name": "Firnkey",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "140",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Firnkey",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "fill-login": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "__MSG_fillLoginCommand__"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting", "offscreen", "alarms", "idle", "clipboardWrite", "favicon", "contextMenus"],
  "optional_permissions": ["webRequest", "webRequestAuthProvider", "clipboardRead"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
